<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header area with Title and Header Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TrackWise"
            android:textColor="#0F172A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_header_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tuesday, Jul 7"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="normal" />
    </LinearLayout>

    <!-- Top Navigation Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/btn_tab_1"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tab_active"
            android:text="Planner"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_tab_2"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_tab_inactive"
            android:text="Wellbeing"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_tab_3"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_tab_inactive"
            android:text="Wealth"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Subdued Separator -->
    <ImageView
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <!-- Left Column: Interactive List Rows -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.8"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Row 1 -->
            <LinearLayout
                android:id="@+id/layout_item1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="3dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:id="@+id/txt_item1_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:text="Top Task:"
                    android:textColor="#0F172A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/txt_item1_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="None"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:gravity="end"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:id="@+id/layout_item2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="3dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:id="@+id/txt_item2_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:text="Top Habit:"
                    android:textColor="#0F172A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/txt_item2_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="None"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:gravity="end"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:id="@+id/layout_item3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="3dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:id="@+id/txt_item3_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:text="Occasion:"
                    android:textColor="#0F172A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/txt_item3_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="None today"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:gravity="end"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Column: Pie / Donut Chart -->
        <FrameLayout
            android:id="@+id/layout_right_pane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/img_pie_chart"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="Visual Progress" />
        </FrameLayout>
    </LinearLayout>

    <!-- Footer Timestamp -->
    <TextView
        android:id="@+id/widget_footer_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Last updated: Just now"
        android:textColor="#64748B"
        android:textSize="8sp"
        android:gravity="end"
        android:layout_marginTop="2dp" />

</LinearLayout>
