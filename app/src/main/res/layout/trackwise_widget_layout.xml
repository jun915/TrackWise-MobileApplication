<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Navigation Tabs (Teams/Analytics Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TrackWise"
            android:textColor="#0F172A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Category Selector Row representing Dropdown Analytics -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <TextView
                android:id="@+id/btn_tab_finance"
                android:layout_width="65dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_tab_active"
                android:text="Finance"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_tab_health"
                android:layout_width="65dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_tab_inactive"
                android:text="Health"
                android:textColor="#CBD5E1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_tab_tasks"
                android:layout_width="65dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_tab_inactive"
                android:text="Tasks"
                android:textColor="#CBD5E1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subdued Separator -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/txt_analytics_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Finance Summary"
            android:textColor="#7C3AED"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Metrics Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txt_metric1_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="Balance Status:"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txt_metric1_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.8"
                android:text="₹0.00"
                android:textColor="#0F172A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txt_metric2_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="Spent Today:"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txt_metric2_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.8"
                android:text="₹0.00"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="end" />
        </LinearLayout>

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:progress="0"
            android:max="100" />
    </LinearLayout>

    <!-- Footer Timestamp -->
    <TextView
        android:id="@+id/widget_footer_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Last updated: Just now"
        android:textColor="#64748B"
        android:textSize="9sp"
        android:gravity="end"
        android:layout_marginTop="4dp" />

</LinearLayout>
