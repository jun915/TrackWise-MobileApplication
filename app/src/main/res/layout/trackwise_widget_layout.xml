<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header Area: App Title on left, Small Date + Time + Urdu/Islamic Date + Allah Name on right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TrackWise"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Net balance from monthly finance summary -->
            <TextView
                android:id="@+id/widget_finance_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 Net Balance: ₹0"
                android:textColor="#0EA5E9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="start"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Top Right Small Info: Date/Time + Urdu Date + Allah Name -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/widget_header_time_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sat, Aug 8 • 05:45 PM"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_header_urdu_allah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23 Safar 1448 AH • ﷲ Al-Rahman"
                android:textColor="#7C3AED"
                android:textSize="9sp"
                android:textStyle="normal"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginBottom="6dp" />

    <!-- Section 1: Today's Countdown Events (Max 2) - GONE if no events today -->
    <LinearLayout
        android:id="@+id/layout_events_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_events_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎉 Today's Countdown Events"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_event_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Event 1"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />

        <TextView
            android:id="@+id/txt_event_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Event 2"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Main Content Area: Current Hour Habits and Tasks -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Section 2: Max 2 Habits with reminder for current hour -->
        <LinearLayout
            android:id="@+id/layout_habits_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/txt_habits_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💪 Habits (Current Hour)"
                android:textColor="#0F172A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_habit_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Morning Hydration"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="1dp" />

            <TextView
                android:id="@+id/txt_habit_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Walk 10 mins"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Section 3: Max 2 Tasks with reminder for current hour -->
        <LinearLayout
            android:id="@+id/layout_tasks_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/txt_tasks_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 Tasks (Current Hour)"
                android:textColor="#0F172A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_task_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Review project milestone"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="1dp" />

            <TextView
                android:id="@+id/txt_task_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Call team lead"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Quick Stats Row: Water Intake + Most Slipped Up Habit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/txt_water_stat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💧 0 / 8 glasses"
            android:textColor="#0EA5E9"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_slipped_stat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="⚠️ Most Slipped: None"
            android:textColor="#F43F5E"
            android:textSize="10sp"
            android:gravity="end"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Footer Timestamp -->
    <TextView
        android:id="@+id/widget_footer_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Last updated: Just now"
        android:textColor="#64748B"
        android:textSize="8sp"
        android:gravity="end" />

</LinearLayout>