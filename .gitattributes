# Auto detect text files and perform LF normalization
* text=auto

# Declare files that will always have LF line endings on checkout.
*.sh text eol=lf
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.aar binary
*.apk binary
